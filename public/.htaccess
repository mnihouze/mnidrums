# Apache config for the Angular app (HostGator).
# Copied to the site root by the build (public/ -> dist/.../browser/).

# --- Single-page app routing -------------------------------------------------
# Routes like /metronome-plus only exist inside Angular. Without this, opening
# them directly or refreshing the page returns Apache's 404. Serve index.html
# for anything that is not a real file or folder.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# --- Caching -----------------------------------------------------------------
# index.html must always be revalidated so a new deploy shows up right away;
# the hashed bundles (main-ABCD1234.js, styles-ABCD1234.css) never change, so
# they can be cached for a long time.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "-[A-Z0-9]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
